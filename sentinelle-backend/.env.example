# Copier en .env et adapter. Toutes les variables sont optionnelles (valeurs par défaut raisonnables).

# --- Général ---
SENTINELLE_ENV=development          # development | production
SENTINELLE_DEBUG=false
# IMPORTANT en production : sel des condensés de numéros + clé d'application.
SENTINELLE_SECRET_KEY=changez-moi-en-production

# --- Stockage ---
SENTINELLE_DB_PATH=data/sentinelle.db
SENTINELLE_MODEL_PATH=data/model.joblib

# --- Détection ---
SENTINELLE_ML_WEIGHT=0.45           # poids du ML dans le score combiné (0..1)
SENTINELLE_BLOCK_THRESHOLD=3        # signalements distincts avant blocage communautaire

# --- API ---
# Si défini, toutes les routes /api/ exigent l'en-tête HTTP « X-API-Key ».
# SENTINELLE_API_KEY=une-cle-secrete
SENTINELLE_RATE_LIMIT=120           # requêtes/minute par IP (0 = illimité)
SENTINELLE_MAX_MESSAGE_LENGTH=4000

# Port du serveur de développement
PORT=8000
