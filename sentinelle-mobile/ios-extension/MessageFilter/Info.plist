<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist de l'extension de filtrage SMS (cible « MessageFilter »).

  ⚠️ MODÈLE à valider dans Xcode selon la version d'iOS visée. La clé
  ILMessageFilterExtensionNetworkURL active le déféré réseau vers le backend
  Sentinelle ; retirez-la pour un fonctionnement 100 % hors ligne.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Sentinelle Filter</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.identitylookup.message-filter</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).MessageFilterExtension</string>
        <!-- Déféré réseau vers le moteur Sentinelle (HTTPS obligatoire). -->
        <key>ILMessageFilterExtensionNetworkURL</key>
        <string>https://api.sentinelle.ca/api/v1/ios-filter</string>
    </dict>
</dict>
</plist>
