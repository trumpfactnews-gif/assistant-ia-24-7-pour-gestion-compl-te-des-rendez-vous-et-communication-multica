# Copier en .env (dans ce dossier deploy/) et remplir.
# NE JAMAIS committer le vrai .env.

# Domaine pointant (DNS A) vers l'IP du serveur. Caddy obtiendra le certificat HTTPS.
DOMAIN=api.sentinelle.ca

# Sel des condensés de numéros + clé d'application. OBLIGATOIRE.
# Générer : openssl rand -hex 32
SENTINELLE_SECRET_KEY=remplace-moi-par-32-octets-hex

# Clé d'API exigée sur toutes les routes /api/ (recommandé en prod).
# Générer : openssl rand -hex 24
SENTINELLE_API_KEY=remplace-moi

# Origine autorisée pour la console/app (évite « * »).
SENTINELLE_CORS_ORIGIN=https://console.sentinelle.ca

# Réglages métier
SENTINELLE_BLOCK_THRESHOLD=3
SENTINELLE_RATE_LIMIT=120
